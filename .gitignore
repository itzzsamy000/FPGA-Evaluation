# ============================================================
# Vivado / Xilinx generated build artefacts
# ============================================================

# Vivado project cache (fully regeneratable)
*.cache/
booth_approx_research.cache/

# Implementation / synthesis runs (large, regeneratable)
*.runs/
booth_approx_research.runs/

# Simulation working directories
*.sim/
booth_approx_research.sim/

# IP user files (generated by Vivado)
*.ip_user_files/
booth_approx_research.ip_user_files/

# Hardware / bitstream output directories
*.hw/
booth_approx_research.hw/

# Vivado auto-backup and recovery files
*.jou
*.log
*.str
*.dmp
*.pb
*.wdf
*.xsa
*.bit
*.ltx

# Vivado journal and backup projects
.Xil/
*.bak
*.backup.jou
*.backup.log

# ============================================================
# Python
# ============================================================

# Byte-compiled / optimised files
__pycache__/
*.py[cod]
*.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
.env

# Jupyter Notebooks (checkpoints)
.ipynb_checkpoints/

# pytest cache
.pytest_cache/

# mypy / type-checker caches
.mypy_cache/
.dmypy.json

# ============================================================
# OS / editor artefacts
# ============================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/

# Vim swap files
*.swp
*.swo

# ============================================================
# Sensitive / environment files - NEVER commit these
# ============================================================
.env
.env.*
*.pem
*.key
secrets.*
# NumPy binary data files (regeneratable)
*.npz

# Vivado power activity SAIF (regeneratable)
*.saif
